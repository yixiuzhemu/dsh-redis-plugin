# ---------------------------------------------------------------------------
# dsh-redis-plugin environment configuration (example).
#
# Copy to `.env` (or inject these into the deployment) and adjust per stage.
# cordis.patch.yml reads every value below via `!!js` at load time, so NO
# host/port/secret is ever hardcoded in the repo.
#
# Precedence (see src/connection/factory.ts):
#   REDIS_URL  >  REDIS_HOST/REDIS_PORT/REDIS_PASSWORD/REDIS_DB  >  built-in default
# If REDIS_URL is set, host/port/db/password are ignored.
# ---------------------------------------------------------------------------

# Environment selector: dev | test | uat | prod
# Names which deployment profile injected the values below; logged at startup
# (an unknown value produces a warning). It does NOT itself change the address —
# each stage sets its own REDIS_HOST/REDIS_PORT/etc.
REDIS_ENV=dev

# --- Connection (pick ONE style) -------------------------------------------
# Style A: a single URL (wins over the discrete fields when set)
# REDIS_URL=redis://:your-password@127.0.0.1:6379/0

# Style B: discrete fields
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Optional key namespace -------------------------------------------------
# Recommended when several environments SHARE one Redis instance, so their keys
# never collide. Leave empty when each environment has its own server.
# REDIS_KEY_PREFIX=dev:

# ===========================================================================
# Per-stage samples (uncomment / adapt in each deployment pipeline)
# ===========================================================================
# --- dev ---
# REDIS_ENV=dev
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_KEY_PREFIX=dev:

# --- test ---
# REDIS_ENV=test
# REDIS_HOST=192.168.4.189
# REDIS_PORT=6379
# REDIS_PASSWORD=<from-secret-manager>
# REDIS_DB=1
# REDIS_KEY_PREFIX=test:

# --- uat ---
# REDIS_ENV=uat
# REDIS_HOST=uat-redis.internal
# REDIS_PORT=6379
# REDIS_PASSWORD=<from-secret-manager>
# REDIS_DB=0
# REDIS_KEY_PREFIX=uat:

# --- prod ---
# REDIS_ENV=prod
# REDIS_HOST=prod-redis.internal
# REDIS_PORT=6379
# REDIS_PASSWORD=<from-secret-manager>
# REDIS_DB=0
# REDIS_KEY_PREFIX=prod:
